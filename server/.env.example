PORT=5000
# Runtime and migration database. Never use a production URL for tests.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_tracker
# Disposable database only: the name must end in _test. Tests truncate its application tables.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/task_tracker_test
ALLOW_TEST_DATABASE_RESET=false
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_gmail_app_password_here
FROM_EMAIL=you@gmail.com
FROM_NAME=Task Tracker
FRONTEND_URL=http://localhost:3000
# Optional comma-separated browser origins; defaults to FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000
# Set only when deployed behind a known number of trusted reverse proxies.
TRUST_PROXY_HOPS=0
